# Copy this file to .env and fill in the values from
# Supabase → Project Settings → API.
# Then run: node scripts/sync-config.mjs

# Public. The browser uses these. Row-level security still limits each person.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Address of the Invoice Scraper shown under Invoices. It keeps its own sign-in and Supabase project.
# Leave the line out to use https://180karma.github.io/Invoice_scraper/. Set it empty to hide the scraper.
INVOICE_SCRAPER_URL=https://180karma.github.io/Invoice_scraper/

# Mail uses this same project and WTM's sign-in, so it needs nothing here yet. When Gmail and Outlook
# are connected (Phases 2–5, see src/mail/README.md), their OAuth secrets and the token encryption key
# are set with `supabase secrets set ...`, never in this file or the browser.

# Server only. Used when you run the wtm-admin Edge Function locally.
# Never put this value in js/config.js or any other file the browser loads.
SUPABASE_SERVICE_ROLE_KEY=
