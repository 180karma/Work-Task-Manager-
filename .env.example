# Copy this file to .env and fill in the values from
# Supabase → Project Settings → API.
# Then run: node scripts/sync-config.mjs

# Public. The browser uses these. Row-level security still limits each person.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Address of the Invoice Scraper shown under Invoices. It keeps its own sign-in and Supabase project.
# Leave the line out to use the copy in invoice-scraper/. Set it empty to hide the scraper.
INVOICE_SCRAPER_URL=invoice-scraper/invoice_scraper.html

# Server only. Used when you run the wtm-admin Edge Function locally.
# Never put this value in js/config.js or any other file the browser loads.
SUPABASE_SERVICE_ROLE_KEY=
