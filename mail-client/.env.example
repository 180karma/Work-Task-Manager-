# Copy to .env.local. Only VITE_* variables reach the browser.

# ---- Browser (Phase 1+) ----
# mock = demo mailbox in localStorage; supabase = real backend (Phase 2, not built yet)
VITE_DATA_SOURCE=mock

# ---- Browser (Phase 2) ----
VITE_SUPABASE_URL=
# Public anon key: safe only because every table has RLS.
VITE_SUPABASE_ANON_KEY=

# ---- Server only: set with `supabase secrets set ...`, never in this file's .env.local ----
# SUPABASE_SERVICE_ROLE_KEY=        (Phase 2, Edge Functions)
# TOKEN_ENCRYPTION_KEY=             (Phase 2, AES-GCM key for refresh tokens at rest)
# GOOGLE_OAUTH_CLIENT_ID=           (Phase 3)
# GOOGLE_OAUTH_CLIENT_SECRET=       (Phase 3)
# GOOGLE_OAUTH_REDIRECT_URI=        (Phase 3)
# GOOGLE_PUBSUB_TOPIC=              (Phase 5, Gmail watch() push)
# MICROSOFT_OAUTH_CLIENT_ID=        (Phase 4)
# MICROSOFT_OAUTH_CLIENT_SECRET=    (Phase 4)
# MICROSOFT_OAUTH_TENANT=common     (Phase 4)
# MICROSOFT_OAUTH_REDIRECT_URI=     (Phase 4)
# GRAPH_WEBHOOK_CLIENT_STATE=       (Phase 5, verifies Graph change notifications)
