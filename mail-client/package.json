{
  "name": "universal-mail",
  "private": true,
  "version": "0.1.0",
  "description": "Universal email client for Gmail and Microsoft Outlook accounts (Phase 1: interface on mock data)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:single": "node scripts/build-single.mjs",
    "test:e2e": "npm run build:single && node tests/phase1-e2e.mjs"
  },
  "dependencies": {
    "dompurify": "^3.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "playwright": "^1.48.0"
  }
}
