{
  "name": "wtm",
  "private": true,
  "version": "0.1.0",
  "description": "Work Task Manager. The app itself needs no build; npm is only for the Mail section (React) and the tests.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run build && node tests/e2e.mjs"
  },
  "dependencies": {
    "dompurify": "^3.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "playwright": "^1.48.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
